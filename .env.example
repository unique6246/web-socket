# ══════════════════════════════════════════════════════════════
#  ChatApp – Environment Variables Template
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in real values in .env
#  3. NEVER commit .env to Git — it is listed in .gitignore
# ══════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=otdb
DB_USERNAME=chatapp
DB_PASSWORD=CHANGE_ME
# MySQL root password (used internally by the mysql Docker image)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# ── Spring Boot App ───────────────────────────────────────────
SERVER_PORT=8080

# ── JWT ───────────────────────────────────────────────────────
# Use a long random string (64+ chars). Generate with:
#   openssl rand -hex 64
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_64_CHARS_MIN

# ── Cloudinary (file/image storage) ──────────────────────────
# Sign up at https://cloudinary.com and copy from the dashboard
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ── SMTP / Email ──────────────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_AUTH=true  SMTP_STARTTLS=true
#   SMTP_USER=you@gmail.com  SMTP_PASS=<gmail-app-password>
# Dev (MailHog in Docker):
#   SMTP_HOST=mailhog  SMTP_PORT=1025  SMTP_AUTH=false  SMTP_STARTTLS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_ENABLED=true

# ── App base URL (used in email links) ────────────────────────
APP_BASE_URL=http://localhost:8085

# ── OAuth2 / SSO ──────────────────────────────────────────────
# Google — https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: <APP_BASE_URL>/login/oauth2/code/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub — https://github.com/settings/developers
#   Authorization callback URL: <APP_BASE_URL>/login/oauth2/code/github
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_HOST=kafka
KAFKA_PORT=9092

# ── Instance ID (unique per horizontal replica) ───────────────
INSTANCE_ID=server-1
